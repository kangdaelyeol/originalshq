rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── xtool 팀 페이지 구성원(/admin/xtool에서 관리) ─────────────────────────────
    // 문서 id = 소문자 이메일. 관리자가 등록한 사람만 팀 페이지(/xtool-tech 등)에 들어간다.
    // 첫 관리자 문서는 Firebase 콘솔에서 직접 만든다(콘솔은 규칙을 거치지 않는다).
    function signedInEmail() {
      return request.auth != null && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function emailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // 관리자가 발급한 임시 비밀번호로 들어온 동안(첫 비밀번호를 정하기 전 — mustChangePassword)은
    // 본인 문서만 읽을 수 있다. 표시는 함수(functions-xtool endpoints/members.ts)만 쓰고 지운다.
    function passwordReady(data) {
      return data.get('mustChangePassword', false) != true;
    }

    function isXtoolAdmin() {
      let path = /databases/$(database)/documents/xtoolMembers/$(signedInEmail());
      return emailVerified() && signedInEmail() != '' && exists(path)
        && get(path).data.isAdmin == true && get(path).data.status == 'active'
        && passwordReady(get(path).data);
    }

    function validMemberFields(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.isAdmin is bool
        && data.teams is map && data.teams.size() <= 20
        && data.status in ['active', 'disabled']
        && (data.get('techArea', null) == null || data.techArea in ['visit', 'as'])
        && (data.get('position', null) == null
          || data.position in ['staff', 'associate', 'assistant', 'manager', 'deputy', 'general', 'ceo'])
        && (data.get('groupRole', null) == null || data.groupRole in ['lead', 'member']);
    }

    match /xtoolMembers/{memberId} {
      // 본인 문서는 메일 인증 전에도 읽는다 — 로그인·가입할 때 등록 여부를 확인해야 해서.
      // 기술팀원은 기술팀으로 등록된 사람의 문서를 읽는다(내 업무의 직원 목록) — 다른 팀만
      // 등록된 사람은 못 읽는다. 목록은 where('teams.tech', '==', true)로 물어야 통과한다.
      allow read: if (request.auth != null && signedInEmail() == memberId) || isXtoolAdmin()
        || (isXtoolTeamMember('tech') && resource.data.get('teams', {}).get('tech', false) == true);

      allow create: if isXtoolAdmin()
        && request.resource.data.keys().hasOnly(
          ['email', 'name', 'isAdmin', 'teams', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && request.resource.data.email == memberId
        && validMemberFields(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == signedInEmail();

      // 관리자: 이름·권한·상태·기술팀 담당영역·직책(직책·그룹장/팀원)만. 자기 자신의 관리자 권한을 빼거나 정지할 수는 없다
      // (마지막 관리자가 스스로 잠기는 일을 막는다).
      allow update: if isXtoolAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'isAdmin', 'teams', 'status', 'techArea', 'position', 'groupRole', 'updatedAt'])
        && validMemberFields(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (memberId != signedInEmail()
          || (request.resource.data.isAdmin == true && request.resource.data.status == 'active'));

      // 본인: 로그인 기록(uid·마지막 로그인 시각)만 남긴다.
      allow update: if emailVerified() && signedInEmail() == memberId
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'lastSignInAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lastSignInAt == request.time;

      allow delete: if isXtoolAdmin() && memberId != signedInEmail();
    }

    // ── 기술지원팀 보드(tech 페이지) ─────────────────────────────────────────
    // Monday 캐시(techItems·techBoardMeta·techMeta)와 수정 기록(techEditLogs). 쓰기는
    // 함수(관리자 SDK)만 한다 — 화면은 읽기만.
    function isXtoolTeamMember(team) {
      let path = /databases/$(database)/documents/xtoolMembers/$(signedInEmail());
      return emailVerified() && signedInEmail() != '' && exists(path)
        && get(path).data.status == 'active' && passwordReady(get(path).data)
        && (get(path).data.isAdmin == true || get(path).data.teams.get(team, false) == true);
    }

    match /techItems/{itemId} {
      allow read: if isXtoolTeamMember('tech');
    }

    match /techBoardMeta/{boardKey} {
      allow read: if isXtoolTeamMember('tech');
    }

    match /techMeta/{docId} {
      allow read: if isXtoolTeamMember('tech');
    }

    // item 업데이트(Monday 댓글) 캐시 — 말풍선 패널이 열리자마자 보여 준다. 쓰기는 함수만.
    match /techItemUpdates/{itemId} {
      allow read: if isXtoolTeamMember('tech');
    }

    // 수정 기록 — 기술팀 모두 읽는다(팀원 & 권한의 "로그"). 관리자 화면의 기록 카드도 같은 컬렉션.
    match /techEditLogs/{logId} {
      allow read: if isXtoolTeamMember('tech');
    }

    // 설정 > 배경에 직원이 올린 사진(목록·원본) — 기술팀 모두 읽고, 올리기·지우기는
    // 함수(techAddBackground·techDeleteBackground)만.
    match /techBackgrounds/{backgroundId} {
      allow read: if isXtoolTeamMember('tech');
    }

    match /techBackgroundImages/{backgroundId} {
      allow read: if isXtoolTeamMember('tech');
    }

    // 프로필 사진(설정 > 프로필 사진) — 기술팀 모두 읽고, 쓰기·지우기는 본인 문서만. 사진은 화면이
    // 작게 줄여 bytes로 넣는다(100KB 아래).
    match /xtoolProfiles/{email} {
      allow read: if isXtoolTeamMember('tech');

      allow create, update: if isXtoolTeamMember('tech') && signedInEmail() == email
        && request.resource.data.keys().hasOnly(['email', 'name', 'photo', 'photoType', 'updatedAt'])
        && request.resource.data.email == email
        // 이름은 구성원 이름 그대로 — 화면이 이름으로 사진을 찾아서, 남의 이름을 적으면 그 사람
        // 자리에 내 사진이 뜬다.
        && request.resource.data.name == get(/databases/$(database)/documents/xtoolMembers/$(email)).data.name
        && request.resource.data.photo is bytes && request.resource.data.photo.size() <= 100 * 1024
        && request.resource.data.photoType in ['image/webp', 'image/jpeg', 'image/png']
        && request.resource.data.updatedAt == request.time;

      allow delete: if isXtoolTeamMember('tech') && signedInEmail() == email;
    }

    // This rule allows anyone with your Firestore database reference to view, edit,
    // and delete all data in your Firestore database. It is useful for getting
    // started, but it is configured to expire after 30 days because it
    // leaves your app open to attackers. At that time, all client
    // requests to your Firestore database will be denied.
    //
    // Make sure to write security rules for your app before that time, or else
    // all client requests to your Firestore database will be denied until you Update
    // your rules
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 9, 6);
    }
  }
}